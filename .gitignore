# =========================================================
# Zenzero Hotel — .gitignore
# =========================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/jest-cache

# next.js
/.next/
/out/

# production
/build

# Turbopack
.turbo

# misc
.DS_Store
*.pem
Thumbs.db
*.local
*.local.sql

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
lerna-debug.log*

# env files (NEVER commit secrets)
/.env
.env.local
.env*.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ESLint / Prettier
.eslintcache
.prettierrc.local

# Supabase CLI
supabase/.branches
supabase/.temp
supabase/.db-password

# Generated files
/scripts/image-map.json

# Test scripts
/tmp/

# Database dumps
*.sql.gz
*.dump

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
