# =========================================================
# Zenzero Hotel — Environment Variables Template
# Copy this file to `.env.local` and fill in your values
# =========================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data Layer Toggle
# 1 = use mock data (development without Supabase)
# 0 = use Supabase (production)
USE_MOCK_DATA=1

# Supabase (Public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase (Server-only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_PASSWORD=<database-password>

# Supabase Pooler (scripts/_db-connection.mjs)
# Region of the Supabase pooler endpoint. Default is ap-southeast-1.
# Override when running scripts against a project in a different region.
SUPABASE_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com

# Manager promotion (scripts/promote-manager.mjs)
# Either MANAGER_ID (exact UUID) or MANAGER_EMAIL (resolves via auth.users
# at runtime). EMAIL takes precedence when both are set. If neither is set,
# the legacy hardcoded UID `ba4b825d-…` is used.
MANAGER_ID=
MANAGER_EMAIL=manager@zenzero.test

# Mock data user UIDs (lib/data/mock-housekeeper.ts)
# Only consulted when USE_MOCK_DATA=1. The defaults match the synthetic
# IDs baked into data/mock-*.json — override with real auth.users.id UUIDs
# if you want the mock housekeeper page to filter by a real account.
MOCK_HOUSE_1_UID=u-house-1
MOCK_HOUSE_2_UID=u-house-2
MOCK_RECEP_1_UID=u-recep-1
MOCK_ADMIN_1_UID=u-admin-1

# Cloudflare R2 (Server-only)
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET_NAME=<bucket-name>

# Cloudflare R2 (Public — for image URLs)
R2_PUBLIC_URL=https://<bucket-id>.r2.dev

# Pricing (Public)
NEXT_PUBLIC_TAX_RATE=0.07
NEXT_PUBLIC_RESORT_FEE=150

# Stripe (Server-only — NEVER expose to client)
# Phase 17 ships the payment gateway (Checkout + webhook + refunds).
# Use TEST keys for development (sk_test_…, whsec_…) and LIVE keys in production.
STRIPE_SECRET_KEY=sk_test_<your-test-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>

# Stripe (Public — safe for browser, publishable client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-test-key>
